# ============================================================
#  citylearn-demo  统一 .gitignore
#  规则：只提交源码/文档/配置模板；构建产物、依赖、实验数据、日志一律不入库
# ============================================================

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
*.ipr
*.iws
.vs/
*.swp
*.swo

# 本地 AI / IDE 工作目录（保留在磁盘，不进仓库）
.codebuddy/
.workbuddy/

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node / 前端 ----------
node_modules/
dist/
.output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- LaTeX 编译产物 ----------
*.aux
*.bbl
*.blg
*.bcf
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
*.xdv
*.run.xml
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.lof
*.lot
*.los

# ---------- 实验数据 / 运行产物（体积大）----------
output/
outkpis/
rla_logs/
uploads/
citylearnpy/outputs/
citylearnpy/rla_logs/
citylearnpy/ablation_results/
citylearnpy/checkpoints/
citylearnpy/datasets/
citylearnpy/_archive/
citylearnpy/_tmp_bak*/
citylearnpy/_test_chesca_out/
lightning_logs/
*.ckpt
*.log

# 注意：CityLearn 的场景/数据集以 *.pth / *.pkl 形式存放
# （如 CHESCA-copy/data/schemas/、citylearnpy/datasets/），是运行必需数据，
# 因此这里【不做】 *.pth / *.pkl 的全局忽略，避免误伤数据集。

# ---------- 临时 / 草稿文件 ----------
$null
*.tmp
*.bak
*.bak_*
*_bak_*
~$*
